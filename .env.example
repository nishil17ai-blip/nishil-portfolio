# Required. Get one free at https://console.groq.com -> API Keys
GROQ_API_KEY=paste_your_groq_key_here

# Optional. Defaults shown. Verify model IDs at console.groq.com/docs/models before changing — Groq rotates them.
LLM_MODEL=llama-3.3-70b-versatile
LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
